+// Geometry clipped to the content mask, so masked-out pixels are never rasterized.
+fn clip_bounds_to_mask(bounds: Bounds, mask: Bounds) -> Bounds {
+    let origin = max(bounds.origin, mask.origin);
+    let end = min(bounds.origin + bounds.size, mask.origin + mask.size);
+    return Bounds(origin, max(end - origin, vec2<f32>(0.0)));
+}
+
+fn inside_rect(point: vec2<f32>, rect: vec4<f32>) -> bool {
+    return all(point >= rect.xy) && all(point <= rect.zw);
+}
