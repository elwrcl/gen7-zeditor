+/// Eager frames only while the compositor presents the window at display rate.
+/// Hidden windows (another workspace) still get occasional callbacks, and a
+/// swap issued then blocks the main thread until the next one arrives.
+const EAGER_FRAME_CALLBACK_WINDOW: std::time::Duration = std::time::Duration::from_millis(50);
+
+/// Start the next frame while the previous one is still on the GPU or with the
+/// compositor (disable with GEN7_ZEDITOR_EAGER_FRAMES=0). Waiting for the frame
+/// callback serializes CPU, GPU and composition, which on slow GPUs pushes most
+/// frames past one refresh interval.
+fn eager_frames() -> bool {
+    static EAGER_FRAMES: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *EAGER_FRAMES.get_or_init(|| {
+        std::env::var("GEN7_ZEDITOR_EAGER_FRAMES").map_or(true, |value| value != "0")
+    })
 }
 
